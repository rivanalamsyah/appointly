# =============================================================================
# Appointly — Environment Variables
# Copy this file to .env and fill in all values before running the project.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development                      # development | staging | production
APP_NAME=appointly
APP_VERSION=0.1.0
APP_BASE_URL=http://localhost:8080       # Full URL (no trailing slash)
APP_FRONTEND_URL=http://localhost:4321

# -----------------------------------------------------------------------------
# API Server
# -----------------------------------------------------------------------------
API_PORT=8080
API_READ_TIMEOUT=30s
API_WRITE_TIMEOUT=30s
API_IDLE_TIMEOUT=120s
API_SHUTDOWN_TIMEOUT=30s

# -----------------------------------------------------------------------------
# Database — PostgreSQL
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=appointly_dev
DB_USER=appointly
DB_PASSWORD=changeme_dev_only
DB_SSL_MODE=disable                      # disable | require | verify-full
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=1m

# Connection string (alternative to individual params — takes precedence if set)
# DATABASE_URL=postgres://appointly:changeme@localhost:5432/appointly_dev?sslmode=disable

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_MAX_RETRIES=3
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
# JWT signing secret (min 32 bytes, random)
JWT_SECRET=change_me_to_a_very_long_random_secret_at_least_32_chars
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

# Cookie settings
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false                      # Set to true in production (HTTPS only)
COOKIE_SAME_SITE=Lax                     # Strict | Lax | None

# Password hashing (Argon2id parameters)
ARGON2_MEMORY=65536                      # 64 MB
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=4

# CSRF
CSRF_SECRET=change_me_to_another_random_secret_32_chars
CSRF_SECURE=false

# -----------------------------------------------------------------------------
# Object Storage — MinIO (development) / S3 (production)
# -----------------------------------------------------------------------------
STORAGE_TYPE=minio                       # minio | s3
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=appointly
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=false
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/appointly

# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=smtp                      # smtp | sendgrid | ses | resend
SMTP_HOST=localhost
SMTP_PORT=1025                           # MailHog for development
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Appointly
SMTP_FROM_EMAIL=noreply@appointly.dev
SMTP_TLS=false

# SendGrid (if EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=

# Resend (if EMAIL_PROVIDER=resend)
RESEND_API_KEY=

# -----------------------------------------------------------------------------
# WhatsApp (optional)
# -----------------------------------------------------------------------------
WHATSAPP_PROVIDER=                       # fonnte | wablas | twilio | (empty to disable)
WHATSAPP_API_KEY=
WHATSAPP_FROM_NUMBER=

# -----------------------------------------------------------------------------
# Payment (optional — can be disabled for MVP)
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER=stripe                  # stripe | midtrans | xendit | (empty to disable)

STRIPE_SECRET_KEY=sk_test_
STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOK_SECRET=whsec_

MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_ENV=sandbox                     # sandbox | production

XENDIT_SECRET_KEY=

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_RPM=20                   # requests per minute for auth endpoints
RATE_LIMIT_API_RPM=120                   # requests per minute for API endpoints
RATE_LIMIT_PUBLIC_RPM=60                 # requests per minute for public booking

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:4321,http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# -----------------------------------------------------------------------------
# Worker (Background Jobs)
# -----------------------------------------------------------------------------
WORKER_CONCURRENCY=10
WORKER_QUEUE=default
WORKER_POLL_INTERVAL=1s

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=debug                          # debug | info | warn | error
LOG_FORMAT=text                          # text | json (use json in production)
LOG_ADD_SOURCE=false                     # Add source file/line to log entries

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
# Sentry (optional)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# OpenTelemetry (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=appointly-api

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
FEATURE_ONLINE_PAYMENT=false
FEATURE_WHATSAPP_NOTIFICATION=false
FEATURE_MULTI_LOCATION=true
FEATURE_RESOURCE_BOOKING=true

# -----------------------------------------------------------------------------
# Migrations
# -----------------------------------------------------------------------------
MIGRATE_PATH=db/migrations

# -----------------------------------------------------------------------------
# Development only (remove in production)
# -----------------------------------------------------------------------------
# Seed the database with demo data on startup
DEV_SEED_DATA=false
# Disable auth for development testing
DEV_AUTH_BYPASS=false
