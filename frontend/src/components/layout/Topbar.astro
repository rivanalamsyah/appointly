---
/**
 * Topbar — Fixed top navigation bar for the dashboard.
 * Shows breadcrumb/page title, search, notifications, and org switcher.
 */
export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<header
  class="h-[64px] flex items-center px-6 border-b border-[var(--color-surface-border)] bg-[var(--color-surface-base)] sticky top-0 z-10"
  role="banner"
>
  <!-- Page Title / Breadcrumb -->
  <div class="flex-1 min-w-0">
    <h1 class="text-base font-semibold text-[var(--color-text-primary)] truncate">
      {title}
    </h1>
  </div>

  <!-- Right Actions -->
  <div class="flex items-center gap-2 ml-4">

    <!-- Search trigger -->
    <button
      id="global-search-trigger"
      class="hidden md:flex items-center gap-2 px-3 py-1.5 bg-[var(--color-surface-raised)] border border-[var(--color-surface-border)] rounded-lg text-[var(--color-text-muted)] hover:border-[rgba(255,255,255,0.15)] hover:text-[var(--color-text-secondary)] transition-all duration-150 text-sm"
      aria-label="Open search"
      aria-keyshortcuts="Ctrl+K"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
      </svg>
      <span>Search</span>
      <kbd class="hidden lg:inline-flex items-center px-1.5 py-0.5 text-[10px] font-medium bg-[var(--color-surface-overlay)] rounded border border-[var(--color-surface-border)]">⌘K</kbd>
    </button>

    <!-- Notification bell -->
    <button
      id="notifications-trigger"
      class="relative w-9 h-9 flex items-center justify-center rounded-lg hover:bg-[var(--color-surface-raised)] text-[var(--color-text-muted)] hover:text-[var(--color-text-primary)] transition-colors duration-150"
      aria-label="Notifications (3 unread)"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/>
        <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/>
      </svg>
      <!-- Unread badge -->
      <span
        class="absolute top-1.5 right-1.5 w-2 h-2 rounded-full bg-[var(--color-primary-500)]"
        aria-hidden="true"
      ></span>
    </button>

    <!-- Help -->
    <a
      href="/help"
      class="w-9 h-9 flex items-center justify-center rounded-lg hover:bg-[var(--color-surface-raised)] text-[var(--color-text-muted)] hover:text-[var(--color-text-primary)] transition-colors duration-150"
      aria-label="Help and documentation"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10"/>
        <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/>
        <path d="M12 17h.01"/>
      </svg>
    </a>

  </div>
</header>
