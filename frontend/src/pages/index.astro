---
/**
 * Appointly Landing Page — High-converting SaaS homepage
 * Showcases multi-tenant appointment management features with rich aesthetics.
 */
import '@/styles/global.css';
import { Calendar, Shield, Zap, Users, BarChart3, Clock, Check, ArrowRight, Sparkles, ChevronRight, Globe, Lock } from 'lucide-react';
---

<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Appointly — Production-ready multi-tenant appointment booking & scheduling SaaS platform for service businesses." />
    <title>Appointly — Modern Appointment Booking & Management SaaS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-slate-950 text-slate-100 font-sans antialiased selection:bg-violet-500 selection:text-white min-h-screen flex flex-col">
    {/* Navigation */}
    <nav class="sticky top-0 z-50 bg-slate-950/80 backdrop-blur-xl border-b border-slate-800/80 transition-all">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-violet-600 via-indigo-600 to-cyan-500 flex items-center justify-center text-white font-extrabold shadow-lg shadow-violet-900/40">
            <Calendar class="w-5 h-5" />
          </div>
          <span class="text-xl font-extrabold tracking-tight bg-gradient-to-r from-white via-slate-200 to-slate-400 bg-clip-text text-transparent">
            Appointly
          </span>
        </div>

        <div class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-300">
          <a href="#features" class="hover:text-white transition-colors">Features</a>
          <a href="#solutions" class="hover:text-white transition-colors">Solutions</a>
          <a href="#pricing" class="hover:text-white transition-colors">Pricing</a>
          <a href="/book/luxe-salon" class="hover:text-white transition-colors flex items-center gap-1.5 text-violet-400 font-semibold">
            <Sparkles class="w-4 h-4" /> Live Demo
          </a>
        </div>

        <div class="flex items-center gap-4">
          <a href="/dashboard" class="text-xs font-semibold text-slate-300 hover:text-white transition-colors px-4 py-2.5 rounded-xl border border-slate-800 hover:border-slate-700 bg-slate-900/50">
            Sign In
          </a>
          <a href="/dashboard" class="text-xs font-bold bg-gradient-to-r from-violet-600 to-indigo-600 hover:from-violet-500 hover:to-indigo-500 text-white px-5 py-2.5 rounded-xl transition-all shadow-lg shadow-violet-900/30 hover:shadow-violet-900/50">
            Start Free Trial
          </a>
        </div>
      </div>
    </nav>

    <main class="flex-1">
      {/* Hero Section */}
      <section class="relative pt-20 pb-24 overflow-hidden">
        {/* Glow effects */}
        <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] bg-violet-600/20 rounded-full blur-[140px] pointer-events-none" />
        <div class="absolute top-1/3 left-1/3 w-[300px] h-[300px] bg-cyan-600/15 rounded-full blur-[120px] pointer-events-none" />

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center space-y-8">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-violet-500/30 bg-violet-950/40 text-xs font-semibold text-violet-300 backdrop-blur-md shadow-inner">
            <Sparkles class="w-4 h-4 text-violet-400 animate-pulse" />
            <span>Multi-Tenant Enterprise Architecture Ready</span>
          </div>

          <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold text-white tracking-tight leading-[1.1] max-w-4xl mx-auto">
            Effortless Appointment Scheduling for <span class="bg-gradient-to-r from-violet-400 via-indigo-300 to-cyan-400 bg-clip-text text-transparent">Modern Service Businesses</span>
          </h1>

          <p class="text-lg sm:text-xl text-slate-400 max-w-2xl mx-auto font-normal leading-relaxed">
            Eliminate double bookings with real-time database row locking, manage multiple staff schedules, automate deposit collections, and scale effortlessly across locations.
          </p>

          <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
            <a href="/dashboard" class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-gradient-to-r from-violet-600 to-indigo-600 hover:from-violet-500 hover:to-indigo-500 text-white font-bold text-sm transition-all shadow-xl shadow-violet-900/40 hover:shadow-violet-900/60 flex items-center justify-center gap-2">
              Launch Your Portal <ArrowRight class="w-4 h-4" />
            </a>
            <a href="/book/luxe-salon" class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-800 font-semibold text-sm transition-all flex items-center justify-center gap-2">
              Customer Booking Experience <ChevronRight class="w-4 h-4 text-slate-500" />
            </a>
          </div>

          {/* Social Proof badges */}
          <div class="pt-12 grid grid-cols-2 md:grid-cols-4 gap-6 max-w-3xl mx-auto border-t border-slate-800/80">
            <div>
              <div class="text-2xl font-extrabold text-white font-mono">99.99%</div>
              <div class="text-xs text-slate-500 mt-1">Uptime SLA</div>
            </div>
            <div>
              <div class="text-2xl font-extrabold text-white font-mono">0.0ms</div>
              <div class="text-xs text-slate-500 mt-1">Double Booking Rate</div>
            </div>
            <div>
              <div class="text-2xl font-extrabold text-white font-mono">10x</div>
              <div class="text-xs text-slate-500 mt-1">Slot Query Speed</div>
            </div>
            <div>
              <div class="text-2xl font-extrabold text-white font-mono">100%</div>
              <div class="text-xs text-slate-500 mt-1">Multi-Tenant Isolation</div>
            </div>
          </div>
        </div>
      </section>

      {/* Feature Section */}
      <section id="features" class="py-24 bg-slate-900/40 border-y border-slate-800/80">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
          <div class="text-center space-y-4 max-w-2xl mx-auto">
            <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
              Engineered for Speed, Reliability, and Precision
            </h2>
            <p class="text-sm text-slate-400">
              Built on Golang with PostgreSQL explicit locking and Astro SSR for maximum performance.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="bg-slate-900/80 border border-slate-800 p-8 rounded-3xl space-y-4 hover:border-violet-500/50 transition-all">
              <div class="w-12 h-12 bg-violet-500/10 border border-violet-500/30 rounded-2xl flex items-center justify-center text-violet-400">
                <Lock class="w-6 h-6" />
              </div>
              <h3 class="text-lg font-bold text-white">Concurrency Safe Booking</h3>
              <p class="text-xs text-slate-400 leading-relaxed">
                Uses PostgreSQL <code class="bg-slate-950 px-1.5 py-0.5 rounded text-violet-300 font-mono">FOR UPDATE</code> transactions to prevent double bookings under heavy concurrent traffic.
              </p>
            </div>

            <div class="bg-slate-900/80 border border-slate-800 p-8 rounded-3xl space-y-4 hover:border-violet-500/50 transition-all">
              <div class="w-12 h-12 bg-indigo-500/10 border border-indigo-500/30 rounded-2xl flex items-center justify-center text-indigo-400">
                <Globe class="w-6 h-6" />
              </div>
              <h3 class="text-lg font-bold text-white">Multi-Tenant Isolation</h3>
              <p class="text-xs text-slate-400 leading-relaxed">
                Strict database row-level tenant filtering on every query guarantees your business data remains private and secure.
              </p>
            </div>

            <div class="bg-slate-900/80 border border-slate-800 p-8 rounded-3xl space-y-4 hover:border-violet-500/50 transition-all">
              <div class="w-12 h-12 bg-emerald-500/10 border border-emerald-500/30 rounded-2xl flex items-center justify-center text-emerald-400">
                <Clock class="w-6 h-6" />
              </div>
              <h3 class="text-lg font-bold text-white">Dynamic Slot Engine</h3>
              <p class="text-xs text-slate-400 leading-relaxed">
                Calculates real-time available time slots accounting for staff working hours, existing appointments, break times, and service buffers.
              </p>
            </div>
          </div>
        </div>
      </section>
    </main>

    {/* Footer */}
    <footer class="bg-slate-950 border-t border-slate-800/80 py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-6 text-xs text-slate-500">
        <div class="flex items-center gap-3">
          <div class="w-6 h-6 rounded-lg bg-violet-600 flex items-center justify-center text-white font-bold text-xs">
            A
          </div>
          <span class="font-semibold text-slate-400">Appointly SaaS Platform</span>
        </div>
        <div>
          © {new Date().getFullYear()} Appointly Inc. Production-ready Multi-Tenant SaaS Architecture.
        </div>
      </div>
    </footer>
  </body>
</html>
